{
  "name": "downdata",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "prepare": "husky",
    "type-check": "next typegen && tsc --noEmit -p .",
    "analyze": "next experimental-analyze",
    "docs:components": "node scripts/generate-docs.mjs",
    "poll:incidents": "node --env-file=.env scripts/poll-incidents.mjs",
    "import:catalog": "node --env-file=.env scripts/import-catalog.mjs"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,ts,tsx}": "eslint --fix"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "@tanstack/react-query": "5.102.7",
    "@tanstack/react-query-devtools": "5.102.7",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "country-flag-icons": "1.6.20",
    "i18next": "26.3.6",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.11",
    "resend": "6.25.0",
    "temporal-polyfill": "1.0.4"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4",
    "@types/node": "24",
    "@types/react": "19",
    "@types/react-dom": "19",
    "daisyui": "5.7.17",
    "eslint": "9",
    "eslint-config-next": "16.3.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "react-docgen-typescript": "2.4.0",
    "supabase": "2.115.0",
    "tailwindcss": "4",
    "typescript": "5"
  }
}
